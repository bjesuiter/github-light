# This file uses @env-spec syntax and is safe to commit.
# Real .env* files stay gitignored; local macOS secrets should use project-scoped Keychain items.
# Local Keychain convention: service "varlock", account "github-light:<ENV_VAR_NAME>".
# Repo provenance: /Users/bjesuiter/Develop/bjesuiter/github-light
#
# @defaultSensitive=false @defaultRequired=infer
# ---

# Public base URL for local OAuth callback URLs and app links.
# @type=url
APP_BASE_URL=http://localhost:3810

# Better Auth cookie/session secret.
# Local macOS dev Keychain item:
# - service: varlock
# - account: github-light:BETTER_AUTH_SECRET
# - repo: /Users/bjesuiter/Develop/bjesuiter/github-light
# Prompt/choice provenance: BETTER_AUTH_SECRET for github-light at /Users/bjesuiter/Develop/bjesuiter/github-light (local dev secret).
# @sensitive @type=string(minLength=32)
BETTER_AUTH_SECRET=keychain(service="varlock", account="github-light:BETTER_AUTH_SECRET")

# GitHub OAuth app client ID.
# @type=string(minLength=1)
GITHUB_CLIENT_ID=

# GitHub OAuth app client secret.
# Local macOS dev Keychain item:
# - service: varlock
# - account: github-light:GITHUB_CLIENT_SECRET
# - repo: /Users/bjesuiter/Develop/bjesuiter/github-light
# Prompt/choice provenance: GITHUB_CLIENT_SECRET for github-light at /Users/bjesuiter/Develop/bjesuiter/github-light (local dev secret).
# @sensitive @type=string(minLength=1)
GITHUB_CLIENT_SECRET=keychain(service="varlock", account="github-light:GITHUB_CLIENT_SECRET")

# Optional local GitHub token for development OAuth bypass and lifecycle preflight.
# Optional local macOS dev override, when needed:
# GITHUB_DEV_TOKEN=keychain(service="varlock", account="github-light:GITHUB_DEV_TOKEN")
# Prompt/choice provenance: GITHUB_DEV_TOKEN for github-light at /Users/bjesuiter/Develop/bjesuiter/github-light (local dev secret).
# @required=false @sensitive @type=string(minLength=1)
GITHUB_DEV_TOKEN=

# Destructive lifecycle test arming flag. Keep false unless intentionally running create/delete tests.
# @type=boolean
RUN_GITHUB_LIFECYCLE_TESTS=false

# Second destructive lifecycle test arming flag. Keep false unless intentionally running create/delete tests.
# @type=boolean
ALLOW_GITHUB_DESTRUCTIVE_TESTS=false

# Prefix for temporary repositories created by destructive lifecycle tests.
# @type=string(minLength=1)
GITHUB_TEST_REPO_PREFIX=github-light-e2e

# Local TanStack devtools event bus port.
# @type=number
TANSTACK_DEVTOOLS_PORT=42070

# Vite built-in dev flag; listed for audit only.
# @required=false @type=boolean @auditIgnore
DEV=

# Railway deployment timestamp used to populate build metadata.
# @required=false @type=string(minLength=1)
RAILWAY_DEPLOYMENT_CREATED_AT=

# Alternate Railway deployment timestamp used to populate build metadata.
# @required=false @type=string(minLength=1)
RAILWAY_DEPLOYMENT_TIMESTAMP=

# Railway commit SHA used to populate build metadata.
# @required=false @type=string(minLength=1)
RAILWAY_GIT_COMMIT_SHA=

# GitHub Actions commit SHA fallback used to populate build metadata.
# @required=false @type=string(minLength=1)
GITHUB_SHA=

# Generic platform commit SHA fallback used to populate build metadata.
# @required=false @type=string(minLength=1)
SOURCE_VERSION=

# Vite build timestamp exposed to the client.
# @required=false @type=string(minLength=1)
VITE_DEPLOYED_AT=

# Vite build commit hash exposed to the client.
# @required=false @type=string(minLength=1)
VITE_BUILD_COMMIT_HASH=
