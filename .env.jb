# JB local dev profile for github-light.
# Selected by gitignored .env.local containing DEV_ENV=jb.
# Security CLI Keychain fallback convention: service "varlock", account "github-light:jb:<ENV_VAR_NAME>".
# Repo provenance: /Users/bjesuiter/Develop/bjesuiter/github-light

# Better Auth cookie/session secret for github-light / jb / local dev.
# Keychain service: varlock
# Keychain account: github-light:jb:BETTER_AUTH_SECRET
# Prompt/choice provenance: BETTER_AUTH_SECRET in github-light profile jb at /Users/bjesuiter/Develop/bjesuiter/github-light (local dev secret).
BETTER_AUTH_SECRET=exec("security find-generic-password -s varlock -a \"github-light:jb:BETTER_AUTH_SECRET\" -w")

# GitHub OAuth app client secret for github-light / jb / local dev.
# Keychain service: varlock
# Keychain account: github-light:jb:GITHUB_CLIENT_SECRET
# Prompt/choice provenance: GITHUB_CLIENT_SECRET in github-light profile jb at /Users/bjesuiter/Develop/bjesuiter/github-light (local dev secret).
GITHUB_CLIENT_SECRET=exec("security find-generic-password -s varlock -a \"github-light:jb:GITHUB_CLIENT_SECRET\" -w")

# Optional local GitHub token for development OAuth bypass and lifecycle preflight.
# Keychain service: varlock
# Keychain account: github-light:jb:GITHUB_DEV_TOKEN
# Prompt/choice provenance: GITHUB_DEV_TOKEN in github-light profile jb at /Users/bjesuiter/Develop/bjesuiter/github-light (local dev secret).
# Uncomment when this profile needs the optional token:
# GITHUB_DEV_TOKEN=exec("security find-generic-password -s varlock -a \"github-light:jb:GITHUB_DEV_TOKEN\" -w")
